<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- SÓLO EN DEBUG: pruebas en el emulador por adb (protegido con DUMP: sólo adb puede usarlo). -->
        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.lucyremota.emisor.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
