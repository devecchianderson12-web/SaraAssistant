<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Lucy</string>

    <color name="sara_background">#FF0A0B10</color>

    <!-- Capa de la esfera: transparente, sin animaciones de ventana, a pantalla completa. -->
    <style name="Theme.Sara.Sphere" parent="android:Theme.Translucent.NoTitleBar.Fullscreen">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Sara" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sara_background</item>
        <item name="android:statusBarColor">@color/sara_background</item>
        <item name="android:navigationBarColor">@color/sara_background</item>
    </style>
    <string name="accessibility_description">Permite pedirle a Lucy «cerrá las apps»: abre Recientes y toca «Cerrar todo». Lucy no lee ni guarda lo que hay en pantalla.</string>
</resources>
