<?xml version="1.0" encoding="utf-8"?>
<!-- Lucy: un anillo fucsia → dorado (su burbuja es un anillo) con una «L» blanca y un destello. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Relleno oscuro dentro del anillo -->
    <path
        android:fillColor="#FF1A0F24"
        android:pathData="M54,54m-21,0a21,21 0,1 1,42 0a21,21 0,1 1,-42 0" />
    <!-- Anillo -->
    <path
        android:pathData="M54,54m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0"
        android:strokeWidth="8.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="76"
                android:endY="76"
                android:startX="32"
                android:startY="32"
                android:type="linear">
                <item android:color="#FFFF2EA6" android:offset="0" />
                <item android:color="#FFFF6A6A" android:offset="0.5" />
                <item android:color="#FFFFB42E" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Brillo del anillo -->
    <path
        android:pathData="M38.5,40.5A22,22 0,0 1,54 32"
        android:strokeWidth="2.6"
        android:strokeAlpha="0.55"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />
    <!-- «L» -->
    <path
        android:pathData="M48.5,43L48.5,64L62,64"
        android:strokeWidth="5.6"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Destello dorado -->
    <path
        android:fillColor="#FFFFD27A"
        android:pathData="M77,27l1.6,4.4l4.4,1.6l-4.4,1.6l-1.6,4.4l-1.6,-4.4l-4.4,-1.6l4.4,-1.6z" />
</vector>
